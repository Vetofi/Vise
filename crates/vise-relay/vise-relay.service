[Unit]
Description=Vise play-with-friends relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/vise-relay
Environment=PORT=7000
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
